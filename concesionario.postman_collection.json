      "name": "token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var jsonData = pm.response.json();\npm.environment.set(\"user_token\", jsonData.token);\n\npm.test(\"Status code is 201 or 200\", function () {\n    pm.expect(pm.response.code).to.be.oneOf([200, 201]);\n});\n\npm.test(\"Response has a token\", function () {\n    pm.expect(jsonData).to.have.property(\"token\");\n    pm.expect(jsonData.token).to.be.a(\"string\");\n});"
            ]
          }
        }
      ],
